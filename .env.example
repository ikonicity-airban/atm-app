# ==============================================================================
# Ascent Transport Management (ATM Nigeria) - Environment Variables
# ==============================================================================

# Database: Neon PostgreSQL Connection String
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/atmnigeria?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-random-secret-key-for-better-auth"
BETTER_AUTH_URL="https://atmnigeria.com"

# Paystack Payment Gateway (NGN Integer Kobo transactions & Webhooks)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-signing-secret"

# Termii Notifications (Transactional SMS & WhatsApp dispatch in Nigeria)
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="ATMNigeria"

# Resend Email Provider (Transactional Booking & Ticket PDF delivery)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="tickets@atmnigeria.com"

# Data Source switch: 'static' (in-memory constants) or 'db' (PostgreSQL / Neon)
DATA_SOURCE="static"

# Public Application URLs
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

