{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "esModuleInterop": true,
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@web/*": ["../../apps/web/src/*"],
      "@atm/shared": ["./src/index.ts"],
      "@atm/db": ["../db/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
